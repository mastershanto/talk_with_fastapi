# Environment variables template
# Copy this file to .env and fill in your actual database password

# PostgreSQL Connection String
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://avnadmin:YOUR_PASSWORD_HERE@localhost:5432/defaultdb

# For Aiven Cloud PostgreSQL (after IP whitelisting):
# DATABASE_URL=postgresql://avnadmin:YOUR_PASSWORD_HERE@pg-xxxxx.a.aivencloud.com:28124/defaultdb?sslmode=require

# ── Auth / JWT ──────────────────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-use-openssl-rand
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── SMTP (Email OTP delivery) ───────────────────────────────────────────────
# Set SMTP_ENABLED=true to actually send OTP emails.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
